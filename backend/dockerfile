# syntax=docker/dockerfile:1

# This Dockerfile is meant to be executed with the parent directory as build context,
# e.g. `docker build -f backend/dockerfile .`

FROM node:26-alpine AS build

# pnpm
COPY --from=ghcr.io/pnpm/pnpm:12-alpine /opt/pnpm /opt/pnpm
RUN mkdir -p /usr/local/bin \
    && ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

# ENV NPM_CONFIG_LOGLEVEL=info
ENV NODE_ENV=production

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY ./backend/ ./backend/
COPY ./common/ ./common/
COPY ./jdp/ ./jdp/ 
COPY ./backend/entrypoint.sh /

RUN pnpm -F backend -F common -F jdp -F types ci --prod --ignore-scripts

RUN node -p "require('./package.json').version" > ./backend/.version
RUN rm -f package.json pnpm-lock.yaml pnpm-workspace.yaml





FROM node:26-alpine

ENV NODE_ENV=production

USER node
WORKDIR /app

COPY --chown=node:node --from=build /app /app
RUN mkdir -p /app/backend/database/data
VOLUME /app/backend/database/data

COPY --from=build entrypoint.sh ./
ENTRYPOINT ["/app/entrypoint.sh"]

EXPOSE 3000
