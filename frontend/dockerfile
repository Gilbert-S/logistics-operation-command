# syntax=docker/dockerfile:1

# This Dockerfile is meant to be executed with the parent directory as build context,
# e.g. `docker build -f backend/dockerfile .`

FROM dhi.io/node:26-alpine-dev AS build

# ENV NPM_CONFIG_LOGLEVEL=info

# pnpm
COPY --from=ghcr.io/pnpm/pnpm:12-alpine /opt/pnpm /opt/pnpm
RUN mkdir -p /usr/local/bin \
    && ln -s /opt/pnpm/pnpm /usr/local/bin/pnpm

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY ./frontend/ ./frontend/
COPY ./common/ ./common/
COPY ./jdp/ ./jdp/
COPY ./types/ ./types/

RUN --mount=type=cache,id=pnpm,target=/var/cache/pnpm \
  pnpm -F frontend -F common -F jdp -F types ci --store-dir /var/cache/pnpm --ignore-scripts

RUN pnpm -F frontend build





FROM dhi.io/caddy:2

ARG BACKEND_SERVICE_NAME=backend
ARG BASE_URL=https://localhost



WORKDIR /app
VOLUME /data
EXPOSE 80 443


COPY --from=build /app/frontend/dist/frontend/browser/ ./

COPY <<EOF /etc/caddy/Caddyfile
${BASE_URL} {
  encode

  @backend path /socket.io/* /auth/*
  @shell path / /index.html

  header @shell Cache-Control no-cache

  handle @backend {
    reverse_proxy ${BACKEND_SERVICE_NAME}:3000 {
      stream_timeout 12h
      stream_close_delay 5m
    }
  }

  handle {
    root /app
    try_files {path} /index.html
    file_server
  }
}
EOF
